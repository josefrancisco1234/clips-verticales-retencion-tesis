%% Protocolo experimental: desarrollo (v1) → hipótesis preregistrada → confirmación (v2)
flowchart TB
    subgraph V1["Desarrollo · v1 (62 videos, 50.6 h)"]
        CV["Validación cruzada<br/>GroupKFold k=5 POR CANAL"]
        VAR["Variantes probadas:<br/>features relativas (rk, cx)<br/>etiqueta pico · 10 grados"]
        WIL["Wilcoxon pareado<br/>por video"]
    end

    PRE["Hipótesis PREREGISTRADA (D-022)<br/>rel_rk mejora NDCG@10<br/>α = 0.05 unilateral"]

    subgraph V2["Confirmación · v2 (videos nuevos)"]
        NEW["+58 ES por búsqueda<br/>+32 EN por búsqueda<br/>+80 EN de Repurpose"]
        TEST["Entrenar en v1 → evaluar en v2<br/>(nunca usados para decidir)"]
    end

    subgraph RES["Resultados"]
        OK["Se confirma:<br/>se adopta y se reporta"]
        NO["No se confirma:<br/>se descarta y se reporta igual"]
    end

    FIN["Modelo final<br/>models/ranker_lgbm.txt<br/>+ docs/02_auditoria_modelo.md"]

    CV --> VAR --> WIL --> PRE
    PRE --> TEST
    NEW --> TEST
    TEST --> OK
    TEST --> NO
    OK --> FIN
    NO --> FIN

